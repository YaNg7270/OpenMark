    "reason": "Unclosed group `{` must be reported as math-unbalanced-braces.",
    "category": "error"
  },
  {
    "id": "m307",
    "tex": "a}b",
    "display": false,
    "delimiter": "dollar",
    "packages": [],
    "expect": "error",
    "reason": "Unmatched closing brace must be reported as math-unbalanced-braces.",
    "category": "error"
  },
  {
    "id": "m308",
    "tex": "\\begin{align} a &= b",
