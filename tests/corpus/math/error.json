[
  {
    "id": "m300",
    "tex": "\\thisIsNotAMacro{}",
    "display": false,
    "delimiter": "dollar",
    "packages": [],
    "expect": "error",
    "reason": "Unknown control sequence: MathJax reports `Undefined control sequence \\thisIsNotAMacro`.",
    "category": "error"
  },
  {
    "id": "m301",
    "tex": "\\notacommand",
    "display": false,
    "delimiter": "dollar",
    "packages": [],
    "expect": "error",
    "reason": "Bare unknown control sequence must be reported as math-unknown-macro, not silently dropped.",
    "category": "error"
  },
  {
    "id": "m302",
    "tex": "\\frac{a}",
    "display": true,
    "delimiter": "dollar-block",
    "packages": [],
    "expect": "error",
    "reason": "`\\frac` needs two arguments; only one was supplied.",
    "category": "error"
  },
  {
    "id": "m303",
    "tex": "\\frac",
    "display": true,
    "delimiter": "dollar-block",
    "packages": [],
    "expect": "error",
    "reason": "`\\frac` with no arguments is an error.",
    "category": "error"
  },
  {
    "id": "m304",
    "tex": "\\sqrt[3{x}",
    "display": false,
    "delimiter": "dollar",
    "packages": [],
    "expect": "error",
    "reason": "`\\sqrt` bracket and brace do not pair: the optional argument is unterminated.",
    "category": "error"
  },
  {
    "id": "m305",
    "tex": "\\frac{1}{",
    "display": false,
    "delimiter": "dollar",
    "packages": [],
    "expect": "error",
    "reason": "Unclosed `{` after the second argument — math-unbalanced-braces.",
    "category": "error"
  },
  {
    "id": "m306",
    "tex": "{a+b",
