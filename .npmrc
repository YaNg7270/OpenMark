# Project-local registry override.
# The machine's user-level ~/.npmrc points at a mirror that lags behind upstream
# for several packages (e.g. create-wdio@10.0.2), which breaks installs.
# Pin the canonical registry for this project only.
registry=https://registry.npmjs.org/

# pnpm defaults; stated explicitly so builds are reproducible.
strict-peer-dependencies=false
auto-install-peers=true
